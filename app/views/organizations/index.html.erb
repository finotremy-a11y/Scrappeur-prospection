<div class="orgs-page">
  <div class="page-header">
    <div class="title-group">
      <h1>📋 Base de Données Globales</h1>
      <p>Annuaire multi-sources B2B (Écoles, Médical, Associations, Mairies...)</p>
    </div>
    <div class="header-stats">
      <span class="stat-badge"><strong><%= Organization.count %></strong> contacts au total</span>
      <span class="stat-badge ready"><strong><%= Organization.with_email.count %></strong> avec email</span>
    </div>
  </div>

  <% if notice %>
    <div class="alert-notice"><%= notice %></div>
  <% end %>

  <%# Search & Filter Card %>
  <div class="filter-card card">
    <%= form_with url: root_path, method: :get, class: "search-form", local: true do |form| %>
      <div class="form-row">
        <div class="form-group">
          <label>Catégorie</label>
          <%= form.select :category, Organization.categories.keys.map { |k| [k.humanize, k] }, { include_blank: "Toutes les catégories", selected: params[:category] }, class: "select-input" %>
        </div>
        <div class="form-group flex-grow">
          <label>Recherche</label>
          <%= form.text_field :search, value: params[:search], placeholder: "Rechercher par nom, ville, département...", class: "text-input" %>
        </div>
        <div class="form-group btn-group">
          <%= form.submit "🔍 Filtrer", class: "btn-filter" %>
          <% if params[:category].present? || params[:search].present? %>
            <%= link_to "Réinitialiser", root_path, class: "btn-reset" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Results Table Card %>
  <div class="table-card card">
    <div class="table-header">
      <h2>Organisations répertoriées</h2>
      <% if @organizations.any? %>
        <span class="results-info"><%= page_entries_info @organizations %></span>
      <% end %>
    </div>

    <% if @organizations.empty? %>
      <div class="empty-state">
        <p>Aucune organisation trouvée !</p>
        <p class="empty-subtitle">
          Allez dans l'onglet <%= link_to "🔍 Scraping", scraping_index_path, class: "empty-link" %> pour alimenter la base de données.
        </p>
      </div>
    <% else %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Catégorie</th>
              <th>Source</th>
              <th>Nom</th>
              <th>Ville / Dpt</th>
              <th>Email</th>
              <th class="actions-col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @organizations.each do |org| %>
              <tr>
                <td><span class="badge cat-<%= org.category %>"><%= org.category.titleize %></span></td>
                <td><span class="source-tag"><%= org.source %></span></td>
                <td class="org-name"><%= org.name.titleize %></td>
                <td class="org-location"><%= org.city.presence || org.department %></td>
                <td>
                  <% if org.email.present? && org.email.include?('@') && !org.email.start_with?('Visiter:', 'Tél:') %>
                    <a href="mailto:<%= org.email %>" class="email-link"><%= org.email %></a>
                  <% elsif org.email.present? %>
                    <span class="phone-link"><%= org.email %></span>
                  <% else %>
                    <span class="no-email">Non renseigné</span>
                  <% end %>
                </td>
                <td class="actions-col">
                  <%= button_to organization_path(org), method: :delete, data: { turbo_confirm: "Supprimer #{org.name.titleize} ?" }, class: "btn-delete", title: "Supprimer" do %>
                    🗑️
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="pagination-container">
        <%= paginate @organizations %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .orgs-page { max-width: 1100px; margin: 0 auto; padding: 20px; font-family: 'Inter', sans-serif; }
  .page-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
  .page-header h1 { font-size: 1.8rem; margin: 0 0 4px; font-weight: 700; color: #1e293b; }
  .page-header p { margin: 0; color: #64748b; font-size: 0.95rem; }
  .header-stats { display: flex; gap: 12px; }
  .stat-badge { background: #f0f4ff; color: #2563eb; padding: 8px 16px; border-radius: 999px; font-size: 0.9rem; }
  .stat-badge.ready { background: #f0fdf4; color: #16a34a; }

  .alert-notice { background: #d1fae5; color: #065f46; padding: 12px 18px; border-radius: 8px; margin-bottom: 20px; font-weight: 500; }

  .card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }

  .filter-card { padding: 20px 24px; }
  .form-row { display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group.flex-grow { flex: 1; min-width: 240px; }
  .form-group label { font-size: 0.85rem; font-weight: 600; color: #475569; }

  .select-input, .text-input { padding: 9px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.95rem; font-family: 'Inter', sans-serif; }
  .select-input:focus, .text-input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }

  .btn-group { display: flex; flex-direction: row; gap: 8px; align-items: center; }
  .btn-filter { background: #2563eb; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 0.95rem; font-weight: 600; transition: background 0.2s; white-space: nowrap; }
  .btn-filter:hover { background: #1d4ed8; }
  .btn-reset { color: #64748b; text-decoration: none; font-size: 0.88rem; font-weight: 500; padding: 8px 12px; border-radius: 6px; border: 1px solid #e2e8f0; }
  .btn-reset:hover { background: #f8fafc; color: #1e293b; }

  .table-card { padding: 0; overflow: hidden; }
  .table-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #e5e7eb; }
  .table-header h2 { margin: 0; font-size: 1.2rem; font-weight: 700; color: #1e293b; }
  .results-info { font-size: 0.85rem; color: #64748b; font-weight: 500; }

  .table-wrapper { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; text-align: left; }
  th, td { padding: 14px 20px; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; }
  th { background-color: #f8fafc; font-weight: 600; color: #475569; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
  tr:hover { background-color: #f8fafc; }

  .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; background-color: #e0e7ff; color: #3730a3; text-transform: capitalize; }
  .source-tag { color: #64748b; font-size: 0.85rem; }
  .org-name { font-weight: 600; color: #1e293b; }
  .org-location { color: #475569; }
  .email-link { color: #2563eb; text-decoration: none; font-weight: 500; }
  .email-link:hover { text-decoration: underline; }
  .phone-link { color: #475569; font-size: 0.85rem; }
  .no-email { color: #94a3b8; font-style: italic; font-size: 0.85rem; }

  .actions-col { text-align: right; }
  .btn-delete { background: none; border: none; cursor: pointer; font-size: 1rem; padding: 4px 8px; border-radius: 6px; transition: background 0.15s; }
  .btn-delete:hover { background: #fee2e2; }

  .empty-state { text-align: center; padding: 48px 24px; color: #1e293b; font-weight: 600; }
  .empty-subtitle { font-size: 0.9rem; margin-top: 8px; color: #64748b; font-weight: normal; }
  .empty-link { color: #2563eb; text-decoration: none; font-weight: 600; }
  .empty-link:hover { text-decoration: underline; }

  .pagination-container { padding: 16px 24px; display: flex; justify-content: center; background-color: #f8fafc; border-top: 1px solid #e5e7eb; }
</style>
